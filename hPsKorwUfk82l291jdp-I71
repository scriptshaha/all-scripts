            }}
        })
    end

    local tierWH, tierName = WEBHOOK_LOW, ""
    if best.val >= 300000000 then tierWH, tierName = WEBHOOK_HIGH, ""
    elseif best.val >= 100000000 then tierWH, tierName = WEBHOOK_MID, "" end
    
    task.spawn(pcall, function() requestFunc({Url = tierWH, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = createPayload(false, tierName)}) end)
    task.spawn(pcall, function() requestFunc({Url = WEBHOOK_NORMAL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = createPayload(true, "")}) end)
end

--// SCANNER
local function Scan()
    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Generation" and obj:IsA("TextLabel") then
            local val = parseValue(obj.Text)
            if val >= MIN_VALUE then
                local p = obj.Parent
                local name = p:FindFirstChild("DisplayName") and p.DisplayName.Text or (p.Parent:FindFirstChild("DisplayName") and p.Parent.DisplayName.Text or "Unknown")
                table.insert(found, {name = name, gen = obj.Text, val = val})
            end
        end
    end
    if #found > 0 then sendBundledData(found) end
end

