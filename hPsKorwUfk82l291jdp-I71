--// XOR ENGINE
local function xor(a, b) local r, bitval = 0, 1 while a > 0 or b > 0 do local abit, bbit = a % 2, b % 2 if abit ~= bbit then r = r + bitval end a = (a - abit)/2; b = (b - bbit)/2; bitval = bitval*2 end return r end
local function hex_to_bytes(hex) local bytes = {} for i = 1, #hex, 2 do table.insert(bytes, tonumber(hex:sub(i,i+1),16)) end return bytes end
local function encrypt_jobid(jobId) local keyBytes, data_bytes = hex_to_bytes(XOR_KEY_HEX), {string.byte(tostring(jobId), 1, #tostring(jobId))} local out = {} for i=1,#data_bytes do out[i] = string.format("%02x", xor(data_bytes[i], keyBytes[((i-1)%#keyBytes)+1])%256) end return table.concat(out) end

local function parseValue(text)
    local clean = text:gsub("[^%d%.KMB]", "")
    local num = tonumber(clean:match("[%d%.]+")) or 0
    if text:find("B") then return num * 1e9 end
    if text:find("M") then return num * 1e6 end
    if text:find("K") then return num * 1e3 end
    return num
end

local function sendBundledData(list)
